# Copy to .env.local for local overrides, or paste these into the Vercel
# dashboard under Settings -> Environment Variables.
#
# Both are OPTIONAL for local development: with them unset, `npm run dev`
# routes /api and /ws through the Vite proxy to 127.0.0.1:8000 instead.
#
# Both are REQUIRED in production, because the Vercel-hosted frontend and the
# Render-hosted backend are on different origins and there is no proxy.
#
# NOTE: Vite only exposes variables prefixed with VITE_, and it inlines them at
# BUILD time. After changing either value in Vercel you must redeploy.

# Base origin of the FastAPI backend. No trailing slash, no /api suffix.
VITE_API_URL=https://your-service-name.onrender.com

# WebSocket endpoint. Use wss:// (not ws://) for an https:// backend, or the
# browser will block it as mixed content.
# Optional: if omitted, it is derived from VITE_API_URL by swapping the scheme.
VITE_WS_URL=wss://your-service-name.onrender.com/ws
